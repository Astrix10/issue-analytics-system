# Copy to .env and edit. Never commit .env.
GITHUB_REPO=fastapi/fastapi
# Optional: raises GitHub's rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Required for POST /sync. Use a long random value when deployed.
API_KEY=dev-key
# Each page is 100 items. Keep small while developing.
MAX_PAGES=5
ALLOWED_ORIGINS=http://localhost:5173
# Default is a local SQLite file. On Render/Railway set your Postgres URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
